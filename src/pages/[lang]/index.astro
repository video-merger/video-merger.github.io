---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { VideoMergerStudio } from '../../components/VideoMergerStudio';
import SeoContent from '../../components/SeoContent.astro';
import { type LanguageCode, getTranslations } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'zh' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as LanguageCode;
const t = getTranslations(currentLang);
---

<BaseLayout currentLang={currentLang}>
  <div id="studio-app">
    <VideoMergerStudio client:load currentLang={currentLang} />
  </div>
  <SeoContent currentLang={currentLang} />
</BaseLayout>
