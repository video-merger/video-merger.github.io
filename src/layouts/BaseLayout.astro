---
import Navbar from '../components/Navbar.astro';
import StructuredData from '../components/StructuredData.astro';
import { type LanguageCode, SUPPORTED_LANGUAGES, getTranslations } from '../i18n/translations';
import '../styles/global.css';

interface Props {
  currentLang?: LanguageCode;
  customTitle?: string;
  customDescription?: string;
}

const { currentLang = 'en', customTitle, customDescription } = Astro.props;
const t = getTranslations(currentLang);

const title = customTitle || t.seo.metaTitle;
const description = customDescription || t.seo.metaDescription;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://video-merger.github.io').href;
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-R255X1EMS2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-R255X1EMS2');
    </script>

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={t.seo.keywords} />
    <meta name="author" content="video-merger.github.io" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons & Web App Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#121412" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F7F8F5" media="(prefers-color-scheme: light)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Merge Videos" />

    <!-- Hreflang Alternates -->
    {SUPPORTED_LANGUAGES.map((lang) => (
      <link
        rel="alternate"
        hreflang={lang.code}
        href={`https://video-merger.github.io${lang.path}`}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://video-merger.github.io/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Merge Videos" />
    <meta property="og:locale" content={currentLang === 'en' ? 'en_US' : currentLang} />
    <meta property="og:image" content="https://video-merger.github.io/og-image.png" />
    <meta property="og:image:secure_url" content="https://video-merger.github.io/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Merge Videos Online - Free In-Browser Video Joiner Without Watermark" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://video-merger.github.io/og-image.png" />
    <meta name="twitter:image:alt" content="Merge Videos Online - Free In-Browser Video Joiner Without Watermark" />

    <!-- Rich Structured Data (JSON-LD) -->
    <StructuredData currentLang={currentLang} />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Theme Initialization Script (Zero FOUC) -->
    <script is:inline>
      (function() {
        try {
          const theme = localStorage.getItem('theme');
          const isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-sand-50 dark:bg-studio text-moss-800 dark:text-sand-100 flex flex-col min-h-screen selection:bg-sage-400 selection:text-studio transition-colors duration-200">
    <Navbar currentLang={currentLang} />
    
    <main class="flex-1 flex flex-col">
      <slot />
    </main>

    <footer class="border-t border-sand-200/60 dark:border-studio-border bg-sand-100/40 dark:bg-studio-surface/50 py-8 px-4 sm:px-6 lg:px-8 transition-colors">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-olive-500 dark:text-sage-400">
        <div class="flex items-center gap-2">
          <span class="font-bold text-moss-700 dark:text-sand-300">video-merger.github.io</span>
          <span>•</span>
          <span>{t.nav.privacyBadge}</span>
        </div>
        <div class="flex items-center gap-4">
          <a
            href="https://ko-fi.com/kishara"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-moss-700 dark:hover:text-sand-300 underline underline-offset-4 transition-colors"
          >
            {t.nav.supportDeveloper}
          </a>
          <span>•</span>
          <span>Free & Open Source</span>
        </div>
      </div>
    </footer>
  </body>
</html>
